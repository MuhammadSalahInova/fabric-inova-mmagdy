table Sales
	lineageTag: 92f18494-6eec-4728-82e0-ad695a752c6d
	sourceLineageTag: [dbo].[Sales]

	measure 'Glance Insight' =
			
			VAR CurYear =
			    IF(
			        HASONEVALUE(DimDate[Year]),
			        FORMAT(SELECTEDVALUE(DimDate[Year]), "0"),
			        "All Years"
			    )
			RETURN
			"In " & CurYear &
			", Northwind generated $" &
			FORMAT([Total Sales], "#,##0") &
			" in revenue across " &
			FORMAT([Total Orders], "#,##0") &
			" orders."
		lineageTag: bb9e9382-9597-4591-b171-4254cdbd2ce9

		changedProperty = Name

	measure 'Growth Insight' =
			
			VAR BestYearTable =
			    TOPN(
			        1,
			        SUMMARIZECOLUMNS(
			            DimDate[Year],
			            "Revenue", [Total Sales]
			        ),
			        [Revenue], DESC,
			        DimDate[Year], ASC
			    )
			
			VAR BestYear =
			    MAXX(
			        BestYearTable,
			        DimDate[Year]
			    )
			
			VAR BestRevenue =
			    MAXX(
			        BestYearTable,
			        [Revenue]
			    )
			
			VAR SelectedYear =
			    IF(
			        HASONEVALUE(DimDate[Year]),
			        SELECTEDVALUE(DimDate[Year]),
			        BLANK()
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(SelectedYear),
			    "Selected year (" &
			    FORMAT(SelectedYear, "0") &
			    ") generated $" &
			    FORMAT([Total Sales], "#,##0") &
			    " in sales.",
			
			    "Peak year: " &
			    FORMAT(BestYear, "0") &
			    " with $" &
			    FORMAT(BestRevenue, "#,##0") &
			    " in sales."
			)
		lineageTag: 85705a0d-7f4b-41d2-9b23-6279ab3c678a

		changedProperty = Name

	measure 'Selling Insight' =
			
			VAR TopCategoryTable =
			    TOPN(
			        1,
			        SUMMARIZECOLUMNS(
			            DimCategories[CategoryName],
			            "Revenue", [Total Sales]
			        ),
			        [Revenue], DESC,
			        DimCategories[CategoryName], ASC
			    )
			
			VAR TopCategory =
			    MAXX(
			        TopCategoryTable,
			        DimCategories[CategoryName]
			    )
			
			VAR TopProductTable =
			    TOPN(
			        1,
			        SUMMARIZECOLUMNS(
			            DimProducts[ProductName],
			            "Revenue", [Total Sales]
			        ),
			        [Revenue], DESC,
			        DimProducts[ProductName], ASC
			    )
			
			VAR TopProduct =
			    MAXX(
			        TopProductTable,
			        DimProducts[ProductName]
			    )
			
			RETURN
			"Leading category: " &
			TopCategory &
			". Top product: " &
			TopProduct &
			"."
		lineageTag: 41f0f5b0-fa27-495b-9877-6fceca173be1

		changedProperty = Name

	measure 'Buying Insight' =
			
			VAR TopCustomerTable =
			    TOPN(
			        1,
			        SUMMARIZECOLUMNS(
			            DimCustomers[CompanyName],
			            "Revenue", [Total Sales]
			        ),
			        [Revenue], DESC,
			        DimCustomers[CompanyName], ASC
			    )
			
			VAR TopCustomer =
			    MAXX(
			        TopCustomerTable,
			        DimCustomers[CompanyName]
			    )
			
			RETURN
			"Top customer: " &
			TopCustomer &
			" within the current filter selection."
		lineageTag: 8438dc23-5315-4d86-a958-5c2309323d0f

		changedProperty = Name

	measure 'Operations Insight' =
			
			VAR TopEmployeeTable =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            VALUES(DimEmployees[EmployeeKey]),
			            "Revenue", CALCULATE([Total Sales])
			        ),
			        [Revenue], DESC,
			        DimEmployees[EmployeeKey], ASC
			    )
			
			VAR TopEmployeeKey =
			    MAXX(
			        TopEmployeeTable,
			        DimEmployees[EmployeeKey]
			    )
			
			VAR TopEmployee =
			    CALCULATE(
			        MAX(DimEmployees[FirstName]) &
			        " " &
			        MAX(DimEmployees[LastName]),
			        DimEmployees[EmployeeKey] = TopEmployeeKey
			    )
			
			RETURN
			"On-time delivery: " &
			FORMAT([On-Time Delivery Rate %], "0.0%") &
			". Top performer: " &
			TopEmployee &
			"."
		lineageTag: 16b18a8a-f6e7-442b-a392-20832ccb3889

		changedProperty = Name

