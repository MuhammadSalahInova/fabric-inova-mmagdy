	measure 'Active Customers' = DISTINCTCOUNT(Sales[CustomerKey])
		formatString: 0
		lineageTag: 6157dd1b-cd35-43f8-b1a5-e09ed32e96c3

	measure 'On-Time Delivery Rate %' =
			
			VAR TotalShippedOrders =
			    CALCULATE(
			        DISTINCTCOUNT(Sales[OrderID]),
			        Sales[ShippedDate] <> BLANK(),
			        Sales[RequiredDate] <> BLANK()
			    )
			VAR OnTimeOrders =
			    CALCULATE(
			        DISTINCTCOUNT(Sales[OrderID]),
			        Sales[OnTimeFlag] = 1
			    )
			RETURN
			    DIVIDE(
			        OnTimeOrders,
			        TotalShippedOrders,
			        0
			    )
		lineageTag: 75b5cee4-c4fc-4c62-a934-80413d8986dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Unshipped Orders' =
			
			CALCULATE(
			    DISTINCTCOUNT(Sales[OrderID]),
			    Sales[ShippedDate] = BLANK()
			)
		formatString: 0
		lineageTag: 60d24e18-4cd9-4882-81a5-538dcd663f6e

	measure 'Avg Delivery Days' =
			
			AVERAGEX(
			    VALUES(Sales[OrderID]),
			    CALCULATE(
			        MAX(Sales[DeliveryDays])
			    )
			)
		lineageTag: b0621b3d-aa5d-4318-a80b-bf6c4e2d8795

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Needs Reorder' = IF ( SUM(DimProducts[UnitsInStock]) < SUM(DimProducts[ReorderLevel]), 1, 0 )
		formatString: 0
		lineageTag: a1b2c30b-7a18-4f99-af90-b58954f208be

	measure 'Growth Recommendation' =
			
			VAR PeakYear = CALCULATE(SELECTEDVALUE(DimDate[Year]), TOPN(1, VALUES(DimDate[Year]), CALCULATE(SUM(Sales[LineTotal])), DESC))
			VAR PeakSales = CALCULATE(SUM(Sales[LineTotal]), DimDate[Year] = PeakYear)
			VAR PrevSales = CALCULATE(SUM(Sales[LineTotal]), DimDate[Year] = PeakYear - 1)
			VAR NextSales = CALCULATE(SUM(Sales[LineTotal]), DimDate[Year] = PeakYear + 1)
			VAR GrowthBefore = DIVIDE(PeakSales - PrevSales, PrevSales)
			VAR ChangeAfter = DIVIDE(NextSales - PeakSales, PeakSales)
			RETURN
			    "Sales grew " & FORMAT(GrowthBefore, "0%") & " into " & PeakYear &
			    ", then " & IF(ChangeAfter < 0, "fell " & FORMAT(ABS(ChangeAfter), "0%"), "kept rising " & FORMAT(ChangeAfter, "0%")) &
			    " the year after. Prioritize retention for customers acquired in " & PeakYear & " to protect against the post-peak drop."
		lineageTag: bf3e99e7-11a3-4738-b807-13a2ae1ba83b

	measure 'Operations Recommendation' =
			
			VAR AvgDelivery = AVERAGE(Sales[DeliveryDays])
			VAR OnTimeRate = AVERAGE(Sales[OnTimeFlag])
			VAR SlowestShipper = CALCULATE(SELECTEDVALUE(DimShippers[CompanyName]), TOPN(1, VALUES(DimShippers[CompanyName]), CALCULATE(AVERAGE(Sales[DeliveryDays])), DESC))
			RETURN
			    "Average delivery is " & FORMAT(AvgDelivery, "0.0") & " days at a " & FORMAT(OnTimeRate, "0%") & " on-time rate. " &
			    SlowestShipper & " runs slowest — renegotiate their SLA or shift volume to a faster carrier."
		lineageTag: 9a935a00-6d03-4140-a463-db51b0917a5b

	measure 'Buying Recommendation' =
			
			VAR TopCustomer = CALCULATE(SELECTEDVALUE(DimCustomers[CompanyName]), TOPN(1, VALUES(DimCustomers[CompanyName]), CALCULATE(SUM(Sales[LineTotal])), DESC))
			VAR Concentration = DIVIDE(CALCULATE(SUM(Sales[LineTotal]), DimCustomers[CompanyName] = TopCustomer), SUM(Sales[LineTotal]))
			RETURN
			    TopCustomer & " drives " & FORMAT(Concentration, "0.0%") & " of total revenue. " &
			    IF(Concentration > 0.1, "That's a retention risk — build a dedicated account plan and diversify acquisition.", "Revenue is healthily diversified — keep prioritizing broad acquisition.")
		lineageTag: 48606bf0-07cb-4f0f-8370-bcdeb3fd1b90

	measure 'Selling Recommendation' =
			
			VAR TopCat = CALCULATE(SELECTEDVALUE(DimCategories[CategoryName]), TOPN(1, VALUES(DimCategories[CategoryName]), CALCULATE(SUM(Sales[LineTotal])), DESC))
			VAR BottomCat = CALCULATE(SELECTEDVALUE(DimCategories[CategoryName]), TOPN(1, VALUES(DimCategories[CategoryName]), CALCULATE(SUM(Sales[LineTotal])), ASC))
			RETURN
			    TopCat & " leads sales; " & BottomCat & " lags furthest behind. Bundle " & BottomCat & " with " & TopCat &
			    " in promotions, or reassess whether it's worth the catalog space."
		lineageTag: ddc71d66-7e4b-452f-b764-621632373049

	measure 'Glance Recommendation' =
			
			VAR ThisYear = MAX(DimDate[Year])
			VAR YoY = DIVIDE(CALCULATE(SUM(Sales[LineTotal]), DimDate[Year] = ThisYear) - CALCULATE(SUM(Sales[LineTotal]), DimDate[Year] = ThisYear - 1), CALCULATE(SUM(Sales[LineTotal]), DimDate[Year] = ThisYear - 1))
			RETURN
			    "Overall performance is " & IF(YoY >= 0, "up " & FORMAT(YoY, "0%"), "down " & FORMAT(ABS(YoY), "0%")) & " year-over-year. " &
			    IF(YoY >= 0, "Double down on this year's top category and channel.", "Investigate what drove the decline before setting next quarter's budget.")
		lineageTag: 8f659400-9539-4c13-86c2-ea5977adfe02

	measure 'Seasonality Insight' =
			
			VAR PeakMonth = CALCULATE(SELECTEDVALUE(DimDate[MonthName]), TOPN(1, VALUES(DimDate[MonthName]), CALCULATE(SUM(Sales[LineTotal])), DESC))
			RETURN PeakMonth & " is consistently your strongest sales month."
		lineageTag: 34a4230f-e9be-40f8-ba62-d992366b970a

	measure 'Seasonality Recommendation' =
			
			VAR PeakMonth = CALCULATE(SELECTEDVALUE(DimDate[MonthName]), TOPN(1, VALUES(DimDate[MonthName]), CALCULATE(SUM(Sales[LineTotal])), DESC))
			RETURN "Build up inventory and staffing ahead of " & PeakMonth & ", and test a promotion in your weakest month to smooth the seasonal gap."
		lineageTag: 5fbdd4a1-ca26-4c5e-a68e-4692c8c9aaa9

	measure 'Inventory Insight' =
			
			VAR LowStock = CALCULATE(COUNTROWS(DimProducts), DimProducts[UnitsInStock] < DimProducts[ReorderLevel])
			RETURN LowStock & " product(s) are currently below their reorder level."
		lineageTag: 2ed1624f-42fe-49db-9adb-d02cedf39f47

	measure 'Inventory Recommendation' =
			
			VAR LowStock = CALCULATE(COUNTROWS(DimProducts), DimProducts[UnitsInStock] < DimProducts[ReorderLevel])
			RETURN IF(LowStock > 0, "Reorder now to avoid stockouts — check DimProducts for the exact list.", "All products are stocked above threshold — no action needed.")
		lineageTag: 914328c8-2374-46b8-8686-6dc631833b08

