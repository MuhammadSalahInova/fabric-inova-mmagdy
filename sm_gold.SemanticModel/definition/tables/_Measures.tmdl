	measure 'Avg Order Value Card HTML' = ```
			
			VAR AvgOrderValue = FORMAT(DIVIDE(SUM(Sales[LineTotal]), DISTINCTCOUNT(Sales[OrderID])), "$#,##0")
			VAR TopCountry = 
			    CALCULATE(
			        SELECTEDVALUE(Sales[ShipCountry]),
			        TOPN(1, VALUES(Sales[ShipCountry]), CALCULATE(DIVIDE(SUM(Sales[LineTotal]), DISTINCTCOUNT(Sales[OrderID]))), DESC)
			    )
			RETURN
			"<style>
			.card { position: relative; width: 325px; height: 240px; background-color: #000;
			  display: flex; flex-direction: column; justify-content: end; padding: 18px; gap: 8px;
			  border-radius: 12px; cursor: pointer; color: #fff; font-family: Segoe UI, sans-serif; margin: 12px; }
			.card::before { content: ''; position: absolute; inset: 0; left: -7px; margin: auto;
			  width: 341px; height: 256px; border-radius: 15px;
			  background: linear-gradient(-45deg, #ff6b1c 0%, #ffc340 100%); z-index: -10; pointer-events: none;
			  transition: all 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
			.card::after { content: ''; z-index: -1; position: absolute; inset: 0;
			  background: linear-gradient(-45deg, #ff4500 0%, #ffb700 100%);
			  transform: translate3d(0, 0, 0) scale(0.95); filter: blur(26px); }
			.heading { font-size: 22px; text-transform: capitalize; font-weight: 700; margin: 0; }
			.value { font-size: 38px; font-weight: 700; margin: 0; line-height: 1.1; }
			.card p:not(.heading):not(.value) { font-size: 15px; margin: 0; }
			.card p:last-child { color: #fb923c; font-weight: 600; }
			.card:hover::after { filter: blur(38px); }
			.card:hover::before { transform: rotate(-90deg) scaleX(1.34) scaleY(0.77); }
			</style>
			<div class='card'>
			  <p class='heading'>Avg Order Value</p>
			  <p class='value'>" & AvgOrderValue & "</p>
			  <p>Highest AOV Country</p>
			  <p>" & TopCountry & "</p>
			</div>"
			```
		lineageTag: 7339f779-db40-4a47-85d3-dd69f384f864

	measure 'Card Recommendations' = ```
			
			VAR Header =
			"
			<style>
			.inventory-container {
			    width: 100%;
			    height: 100%;
			    background: #111a2e;
			    border-radius: 12px;
			    padding: 18px;
			    box-sizing: border-box;
			    font-family: Arial, sans-serif;
			    color: white;
			    overflow: auto;
			}
			
			.inventory-title {
			    text-align: center;
			    font-size: 20px;
			    font-weight: 700;
			    color: white;
			    margin-bottom: 15px;
			}
			
			.inventory-table {
			    width: 100%;
			    border-collapse: collapse;
			    font-size: 12px;
			}
			
			.inventory-table th {
			    background: #202c46;
			    color: white;
			    padding: 10px 8px;
			    text-align: left;
			    border-bottom: 2px solid #7b61ff;
			}
			
			.inventory-table td {
			    padding: 8px;
			    border-bottom: 1px solid #303b55;
			    color: #eeeeee;
			}
			
			.inventory-table tr:hover {
			    background: #202b45;
			}
			
			.product {
			    font-weight: 600;
			    color: white;
			}
			
			.number {
			    text-align: center;
			}
			
			.alert {
			    color: #ff9f43;
			    font-weight: 700;
			    text-align: center;
			}
			</style>
			
			<div class='inventory-container'>
			
			<div class='inventory-title'>
			Inventory Replenishment Alert
			</div>
			
			<table class='inventory-table'>
			
			<tr>
			<th>Product Name</th>
			<th>Units In Stock</th>
			<th>Reorder Level</th>
			<th>Company Name</th>
			<th>Needs Reorder</th>
			</tr>
			"
			
			VAR ProductTable =
			    FILTER(
			        SUMMARIZECOLUMNS(
			            DimProducts[ProductName],
			            DimProducts[UnitsInStock],
			            DimProducts[ReorderLevel],
			            DimSuppliers[CompanyName],
			            "ReorderStatus", [Needs Reorder]
			        ),
			        [ReorderStatus] = 1
			    )
			
			VAR HTMLRows =
			    CONCATENATEX(
			        ProductTable,
			        
			        VAR ProductName =
			            DimProducts[ProductName]
			
			        VAR Stock =
			            DimProducts[UnitsInStock]
			
			        VAR ReorderLevel =
			            DimProducts[ReorderLevel]
			
			        VAR Supplier =
			            DimSuppliers[CompanyName]
			
			        RETURN
			            "<tr>
			                <td class='product'>" & ProductName & "</td>
			                <td class='number'>" & FORMAT(Stock, "0") & "</td>
			                <td class='number'>" & FORMAT(ReorderLevel, "0") & "</td>
			                <td>" & Supplier & "</td>
			                <td class='alert'>" & UNICHAR(9888) & " 1</td>
			            </tr>"
			    )
			
			VAR Footer =
			"
			</table>
			</div>
			"
			
			RETURN
			    Header & HTMLRows & Footer
			```
		lineageTag: d846f2b8-0c9a-4c09-bb09-653d5834eb0e

