			        1,
			        CategorySales,
			        [@Sales], DESC
			    )
			RETURN
			    MAXX(
			        TopCategory,
			        'DimCategories'[CategoryName]
			    )
		lineageTag: 61b018f8-001f-4d0a-8bce-8bb0ba5836c3

