	measure 'Total Sales Card HTML' = ```
			
			VAR TotalSales = FORMAT(SUM(Sales[LineTotal]), "$#,##0")
			VAR TopCategory = 
			    CALCULATE(
			        SELECTEDVALUE(DimCategories[CategoryName]),
			        TOPN(1, VALUES(DimCategories[CategoryName]), CALCULATE(SUM(Sales[LineTotal])), DESC)
			    )
			RETURN
			"<style>
			.card { position: relative; width: 325px; height: 240px; background-color: #000;
			  display: flex; flex-direction: column; justify-content: end; padding: 18px; gap: 8px;
			  border-radius: 12px; cursor: pointer; color: #fff; font-family: Segoe UI, sans-serif; margin: 12px; }
			.card::before { content: ''; position: absolute; inset: 0; left: -7px; margin: auto;
			  width: 341px; height: 256px; border-radius: 15px;
			  background: linear-gradient(-45deg, #e81cff 0%, #40c9ff 100%); z-index: -10; pointer-events: none;
			  transition: all 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
			.card::after { content: ''; z-index: -1; position: absolute; inset: 0;
			  background: linear-gradient(-45deg, #fc00ff 0%, #00dbde 100%);
			  transform: translate3d(0, 0, 0) scale(0.95); filter: blur(26px); }
			.heading { font-size: 22px; text-transform: capitalize; font-weight: 700; margin: 0; }
			.value { font-size: 38px; font-weight: 700; margin: 0; line-height: 1.1; }
			.card p:not(.heading):not(.value) { font-size: 15px; margin: 0; }
			.card p:last-child { color: #e81cff; font-weight: 600; }
			.card:hover::after { filter: blur(38px); }
			.card:hover::before { transform: rotate(-90deg) scaleX(1.34) scaleY(0.77); }
			</style>
			<div class='card'>
			  <p class='heading'>Total Sales</p>
			  <p class='value'>" & TotalSales & "</p>
			  <p>Leading Category</p>
			  <p>" & TopCategory & "</p>
			</div>"
			```
		lineageTag: 29e5286d-d211-44e9-af5e-01aaa6ded0f5

	measure 'Total Orders Card HTML' = ```
			
			VAR TotalOrders = FORMAT(DISTINCTCOUNT(Sales[OrderID]), "#,##0")
			VAR MostOrdered = 
			    CALCULATE(
			        SELECTEDVALUE(DimProducts[ProductName]),
			        TOPN(1, VALUES(DimProducts[ProductName]), CALCULATE(SUM(Sales[Quantity])), DESC)
			    )
			RETURN
			"<style>
			.card { position: relative; width: 325px; height: 240px; background-color: #000;
			  display: flex; flex-direction: column; justify-content: end; padding: 18px; gap: 8px;
			  border-radius: 12px; cursor: pointer; color: #fff; font-family: Segoe UI, sans-serif; margin: 12px; }
			.card::before { content: ''; position: absolute; inset: 0; left: -7px; margin: auto;
			  width: 341px; height: 256px; border-radius: 15px;
			  background: linear-gradient(-45deg, #1c6fff 0%, #40e0ff 100%); z-index: -10; pointer-events: none;
			  transition: all 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
			.card::after { content: ''; z-index: -1; position: absolute; inset: 0;
			  background: linear-gradient(-45deg, #0066ff 0%, #00dbde 100%);
			  transform: translate3d(0, 0, 0) scale(0.95); filter: blur(26px); }
			.heading { font-size: 22px; text-transform: capitalize; font-weight: 700; margin: 0; }
			.value { font-size: 38px; font-weight: 700; margin: 0; line-height: 1.1; }
			.card p:not(.heading):not(.value) { font-size: 15px; margin: 0; }
			.card p:last-child { color: #40c9ff; font-weight: 600; }
			.card:hover::after { filter: blur(38px); }
			.card:hover::before { transform: rotate(-90deg) scaleX(1.34) scaleY(0.77); }
			</style>
			<div class='card'>
			  <p class='heading'>Total Orders</p>
			  <p class='value'>" & TotalOrders & "</p>
			  <p>Most Ordered Product</p>
			  <p>" & MostOrdered & "</p>
			</div>"
			```
		lineageTag: 6a578b2f-05ae-40ee-8632-d1b54b3b6821

