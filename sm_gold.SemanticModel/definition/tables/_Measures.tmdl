	measure 'Best Year Sales' =
			
			VAR YearSales =
			    ADDCOLUMNS(
			        ALL('DimDate'[Year]),
			        "@Sales", CALCULATE([Total Sales])
			    )
			VAR BestYear =
			    TOPN(
			        1,
			        YearSales,
			        [@Sales], DESC
			    )
			RETURN
			    MAXX(BestYear, [@Sales])
		formatString: 0
		lineageTag: da82f389-d616-4390-a50a-5b661e498a5a

	measure 'Best Sales Year' =
			
			VAR YearSales =
			    ADDCOLUMNS(
			        ALL('DimDate'[Year]),
			        "@Sales", CALCULATE([Total Sales])
			    )
			VAR BestYear =
			    TOPN(
			        1,
			        YearSales,
			        [@Sales], DESC
			    )
			RETURN
			    FORMAT(
			        MAXX(BestYear, 'DimDate'[Year]),
			        "0"
			    )
		lineageTag: 23d9d6fe-237a-44b3-b837-95fcd697114f

	measure 'Top Sales Category' =
			
			VAR CategorySales =
			    ADDCOLUMNS(
			        ALL('DimCategories'[CategoryName]),
			        "@Sales", CALCULATE([Total Sales])
