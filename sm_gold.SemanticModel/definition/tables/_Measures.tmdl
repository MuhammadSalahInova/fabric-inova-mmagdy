			<th>Product Name</th>
			<th>Units In Stock</th>
			<th>Reorder Level</th>
			<th>Company Name</th>
			<th>Needs Reorder</th>
			</tr>
			"
			
			VAR Rows =
			CONCATENATEX(
			    FILTER(
			        SUMMARIZECOLUMNS(
			            DimProducts[ProductName],
			            DimProducts[UnitsInStock],
